{
    "layer": "top",
    "output": "DP-2",
    "position": "top",
    "height": 34,
    "width": 11,
    "modules-left": ["hyprland/workspaces", "idle_inhibitor", "custom/wallpaper"],



    "custom/wallpaper": {
        "format": "󰸉",
        "on-click": "$HOME/.config/waybar/random_wallpaper.sh",
        "tooltip": false
    },

    "modules-center": ["mpd"],
    "modules-right": ["clock", "custom/weather", "pulseaudio/slider"],
    "reload_style_on_change": true,

    "hyprland/workspaces": {
        "format": "{name}"
    },



	    "custom/weather": {
        "format": "{}°C",
        "tooltip": true,
        "interval": 1800,
        "exec": "curl -s 'wttr.in/?format=%t' | grep -oE '[0-9.-]+'",        
        "exec-if": "ping wttr.in -c1"
    },

    "mpd": {
        "format": "{stateIcon} {artist} - {title}",
        "format-disconnected": "󰝛 Disconnected",
        "format-stopped": "󰓛 THEPROPHAT",
        "state-icons": {
            "paused": "󰏤",
            "playing": "󰐊"
        },
        "on-click": "mpc toggle",
        "interval": 2
    },

    "clock": {
        "format": "{:%a %d %b  %I:%M %p}",
        "tooltip-format": "<big>{:%Y %B}</big>\n<tt><small>{calendar}</small></tt>"
    },

"pulseaudio/slider": {


    "min": 0,


    "max": 100,


    "orientation": "horizontal"

},

    "idle_inhibitor": {
        "format": "{icon}",
        "format-icons": {
            "activated": "",
            "deactivated": ""
        },
        "tooltip": true,
        "tooltip-format-activated": "Stay Awake: ON",
        "tooltip-format-deactivated": "Stay Awake: OFF"
    }
}

}
